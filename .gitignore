# Repositorio — reglas iniciales del SAD
# Lenguaje: R 4.x, estilo tidyverse.
# CLI con optparse; salidas a output/<run_id>/.
# Prohibido look-ahead. La prescriptiva recomienda; no ejecuta \u00f3rdenes.

# === Testdata sintético pregenerado versionado en data/samples/*.csv ===
# Solo se commitea los CSVs pregenerados por CI / version snapshot.
# Cualquier CSV nuevo agregado por scripts/00_datos_sinteticos.R queda ignorado.
# NO agregar más CSVs ac\u00e1 salvo regenerar el snapshot completo y bumpear.
data/samples/operaciones.csv
data/samples/precios.csv
data/samples/posiciones.csv

# === Output \u2192 no se commitea ===
output/

# === R / RStudio ===
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# === renv ===
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/staging/

# === Sensibles / locales ===
.idea/
.vscode/
*.swp

# === OS ===
.DS_Store
Thumbs.db
