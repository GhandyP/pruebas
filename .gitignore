# Repositorio — reglas iniciales del SAD
# Lenguaje: R 4.x, estilo tidyverse.
# CLI con optparse; salidas a output/<run_id>/.
# Prohibido look-ahead. La prescriptiva recomienda; no ejecuta \u00f3rdenes.

# === Testdata sint\u00e9tico \u2192 generado, no versionado ===
data/samples/*.csv

# === Output \u2192 no se commitea ===
output/

# === R / RStudio ===
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# === renv ===
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/staging/

# === Sensibles / locales ===
.idea/
.vscode/
*.swp

# === OS ===
.DS_Store
Thumbs.db
